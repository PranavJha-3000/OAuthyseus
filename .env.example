# One model key is needed for live investigation and screenshot pointing.
# Free tier, recommended: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=            # optional; newest Flash model is picked automatically

# Alternatives (first one set wins, in this order): custom OpenAI-compatible endpoint, Gemini, Groq, OpenRouter, Anthropic
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# ANTHROPIC_API_KEY=

# Optional: dependable search (free tiers). Without these, DuckDuckGo Lite / Bing are scraped.
# TAVILY_API_KEY=
# BRAVE_API_KEY=

# Optional: persist agent-generated guides so share links survive (Upstash Redis REST, free tier)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
